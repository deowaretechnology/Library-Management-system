# MongoDB (application/transactional database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/library

# Sanity (book catalog / CMS)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=            # read-only token, used server-side for draft/preview reads
SANITY_API_WRITE_TOKEN=           # write token — NEVER expose to the client, server-side only

# Auth
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=lms_session

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Online fine payment (optional — student "Pay Online" falls back to a friendly
# message telling them to pay at the counter if these aren't set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications (optional — in-app notifications always work; these add email/WhatsApp)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
CRON_SECRET=

# AI library assistant (optional — the floating chat widget on dashboards shows a
# friendly "not set up yet" message if this is missing; nothing else breaks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
